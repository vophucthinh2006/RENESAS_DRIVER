#ifndef CGC_H
#define CGC_H
#include <stdint.h>

#define SYSC    0x4001E000

#define PRCR        *(volatile uint16_t*)(SYSC + 0x3FE)

#define HOCOCR      *(volatile uint8_t*)(SYSC + 0x036)
#define MOCOCR      *(volatile uint8_t*)(SYSC + 0x038)

#define PLLCCR      *(volatile uint16_t*)(SYSC + 0x028)
#define PLLCR       *(volatile uint8_t*)(SYSC + 0x02A)

#define SCKSCR      *(volatile uint8_t*)(SYSC + 0x026)

#define SCKDIVCR    *(volatile uint32_t*)(SYSC + 0x020)

#define OSCSF       *(volatile uint8_t*)(SYSC + 0x03C)
#define PLLSR       *(volatile uint8_t*)(SYSC + 0x02C)

#endif
