#ifndef GPIO_H
#define GPIO_H
#include <stdint.h>

#define PORT_BASE   0x40080000UL
#define PORT_STRIDE 0x0020UL
#define PORT_ADDR(p) (PORT_BASE + PORT_STRIDE * (p))

#define PORT_PCNTR1(p) (*(volatile uint32_t *)(PORT_ADDR(p) + 0x000))
#define PORT_PCNTR2(p) (*(volatile uint32_t *)(PORT_ADDR(p) + 0x004))
#define PORT_PCNTR3(p) (*(volatile uint32_t *)(PORT_ADDR(p) + 0x008))
#define PORT_PCNTR4(p) (*(volatile uint32_t *)(PORT_ADDR(p) + 0x00C))

#endif
