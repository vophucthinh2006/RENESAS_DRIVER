#include "IIC.h"

void I2C_PinConfig(I2C_t i2c, I2C_PINCFG_t cfg)
{
    uint8_t scl_port, scl_pin;
    uint8_t sda_port, sda_pin;
    uint32_t psel;

    switch (i2c)
    {
        case I2C0:
            if (cfg == I2C_PIN_A){
                scl_port = 4; scl_pin = 0;
                sda_port = 4; sda_pin = 1;
                psel = 0x07;
            } else {
                scl_port = 4; scl_pin = 8;
                sda_port = 4; sda_pin = 7;
                psel = 0x06;
            }
            break;

        case I2C1:
            if (cfg == I2C_PIN_A){
                scl_port = 5; scl_pin = 12;
                sda_port = 5; sda_pin = 11;
                psel = 0x07;
            } else {
                scl_port = 2; scl_pin = 5;
                sda_port = 2; sda_pin = 6;
                psel = 0x07;
            }
            break;

        case I2C2:
            if (cfg == I2C_PIN_A){
                scl_port = 4; scl_pin = 10;
                sda_port = 4; sda_pin = 9;
                psel = 0x07;
            } else {
                scl_port = 4; scl_pin = 15;
                sda_port = 4; sda_pin = 14;
                psel = 0x07;
            }
            break;

        default:
            return;
    }

    /* Unlock */
    PWPR = 0x00;

    /* SCL */
    PmnPFS(scl_port, scl_pin) = PmnPFS_PSEL(psel);
    PmnPFS(scl_port, scl_pin) |= PmnPFS_PMR;
    PmnPFS(scl_port, scl_pin) |= (1 << 6); // NCODR

    /* SDA */
    PmnPFS(sda_port, sda_pin) = PmnPFS_PSEL(psel);
    PmnPFS(sda_port, sda_pin) |= PmnPFS_PMR;
    PmnPFS(sda_port, sda_pin) |= (1 << 6); // NCODR

    /* Lock */
    PWPR = 0x80;
}
