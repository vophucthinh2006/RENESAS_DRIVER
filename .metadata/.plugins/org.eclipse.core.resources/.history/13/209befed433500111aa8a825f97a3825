#ifndef GPIO_H
#define GPIO_H
#include <stdint.h>

#define PORT_BASE      0x40080000UL
#define PORT_STRIDE    0x0020UL
#define PORT_ADDR(p)   (PORT_BASE + PORT_STRIDE * (p))

#define PORT_PCNTR1(p) (*(volatile uint32_t *)(PORT_ADDR(p) + 0x000))
#define PORT_PDR(p)    (*(volatile uint16_t *)(PORT_ADDR(p) + 0x002))
#define PORT_PCNTR2(p) (*(volatile uint32_t *)(PORT_ADDR(p) + 0x004))
#define PORT_PCNTR3(p) (*(volatile uint32_t *)(PORT_ADDR(p) + 0x008))
#define PORT_PCNTR4(p) (*(volatile uint32_t *)(PORT_ADDR(p) + 0x00C))

#define PFS_BASE       0x40080800UL

#define PmnPFS(m, n)   (*(volatile uint32_t *)(PFS_BASE + 0x000 + 0x040*(m) + 0x004*(n)))
#define PWPR           (*(volatile uint8_t *)(PFS_BASE + 0x503))

typedef enum{
    GPIO_PORT0,
    GPIO_PORT1,
    GPIO_PORT2,
    GPIO_PORT3,
    GPIO_PORT4,
    GPIO_PORT5,
    GPIO_PORT6,
    GPIO_PORT7,
    GPIO_PORT8,
    GPIO_PORT9,
    GPIO_PORTA,
    GPIO_PORTB
}GPIO_PORT_t;

uint8_t GPIO_PortToIndex(GPIO_PORT_t port);

#endif
